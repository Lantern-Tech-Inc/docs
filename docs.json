            "pages": [
              "analytics/ai-visibility",
              "analytics/traffic",
              "analytics/citations",
              "analytics/prompt-analysis"
            ]
          },
          {
            "group": "SEO",
            "pages": [
              "seo/overview",
              "seo/site-audit",
              "seo/search-console"
            ]
          },
          {
            "group": "Brand Kit",
            "pages": [
